{
  "name": "inflect-practice",
  "version": "0.1.3",
  "private": true,
  "description": "A focused facial-cue practice studio powered by Presage SmartSpectra.",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "preview": "node scripts/serve.mjs",
    "smoke:sdk": "node scripts/sdk-smoke.mjs",
    "camera:check": "node scripts/native-camera-check.cjs",
    "smoke:desktop": "npm run build && electron tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "esbuild": "0.28.2"
  }
}
